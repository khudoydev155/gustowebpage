# Gusto Coffee Telegram Bot Environment Configuration

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Baristas / Admin Telegram Group ID for booking & order alerts
ADMIN_CHAT_ID=-5392092158

# Gusto Coffee Telegram Mini App URL (e.g. Vercel deployment URL)
MINI_APP_URL=https://gustocoffee.uz

# Polling vs Webhook Mode (False for local testing with polling, True for VPS production with webhook)
USE_WEBHOOK=False
WEBHOOK_URL=https://gustocoffee.uz/bot-webhook
HOST=0.0.0.0
PORT=8080

# Supabase REST API Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ROLE=your-supabase-service-role-key-here
SUPABASE_ANON=your-supabase-anon-key-here
