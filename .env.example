# Telegram notifications for table reservations.
#
# IMPORTANT — do not prefix this with VITE_. Vite inlines every
# VITE_-prefixed variable into the public JS bundle at build time,
# which would expose your bot token to anyone who opens the browser
# console. Keep the token server-side only (e.g. read it from a
# Vercel serverless function under /api) and call that endpoint from
# the client instead of calling api.telegram.org directly.
#
# Bot: @gustobronbot
TELEGRAM_BOT_TOKEN="123456789:your-bot-token-here"
TELEGRAM_CHAT_ID="-5392092158"
